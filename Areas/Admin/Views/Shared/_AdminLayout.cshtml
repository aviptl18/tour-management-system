<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <title>@ViewData["Title"] - Admin</title>

    <!-- ================= BOOTSTRAP CSS ================= -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css"
          rel="stylesheet" />

    <!-- ================= ADMIN CSS ================= -->
    <link rel="stylesheet" href="~/css/admin/admin-layout.css" />

    @RenderSection("Styles", required: false)
</head>
<body>

    <!-- ================= HEADER ================= -->
    <header class="admin-header">
        <div class="header-inner d-flex justify-content-between align-items-center px-3 py-2">
            <span class="fw-bold">Tour Admin</span>

            <form asp-area=""
                  asp-controller="Auth"
                  asp-action="Logout"
                  method="post"
                  class="m-0">
                @Html.AntiForgeryToken()
                <button class="btn btn-sm btn-outline-danger">
                    Logout
                </button>
            </form>
        </div>
    </header>

    <!-- ================= MAIN ================= -->
    <div class="admin-container d-flex">

        <!-- ================= SIDEBAR ================= -->
        <aside class="admin-sidebar">
            <div class="admin-logo">Admin Panel</div>

            <nav class="admin-nav">
                <a asp-area="Admin"
                   asp-controller="Dashboard"
                   asp-action="Index"
                   class="nav-item">
                    Dashboard
                </a>

                <a asp-area="Admin"
                   asp-controller="Tours"
                   asp-action="Index"
                   class="nav-item">
                    Tours
                </a>

                <a asp-area="Admin"
                   asp-controller="Locations"
                   asp-action="Index"
                   class="nav-item">
                    Locations
                </a>

                <a asp-area="Admin"
                   asp-controller="AddOns"
                   asp-action="Index"
                   class="nav-item">
                    Add-Ons
                </a>
            </nav>
        </aside>

        <!-- ================= CONTENT ================= -->
        <main class="admin-content flex-fill p-4">
            @RenderBody()
        </main>

    </div>

    <!-- ================= FOOTER ================= -->
    <footer class="admin-footer text-center py-2">
        © @DateTime.Now.Year — Tour Admin
    </footer>

    <!-- ================= SCRIPTS ================= -->
    <!-- jQuery (optional – used by legacy admin code if any) -->
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

    <!-- 🔥 REQUIRED: BOOTSTRAP JS BUNDLE -->
    <!-- Includes Modal, Carousel, Dropdown, Tooltip -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>

    @RenderSection("Scripts", required: false)

</body>
</html>
