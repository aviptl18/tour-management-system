@model Tour_Module.ViewModels.Admin.Tours.TourAddOnConfigurationViewModel

@{
    ViewData["Title"] = "Configure Add-Ons";
}

@Html.AntiForgeryToken()

<h2 class="mb-4">Configure Add-Ons for Tour</h2>

<!-- ================= INCLUDED OPTIONS ================= -->
<div class="card mb-4 shadow-sm">
    <div class="card-header fw-bold bg-light">
        Included Options (Locked)
    </div>

    <div class="card-body">

        @if (!Model.IncludedOptions.Any())
        {
            <div class="text-muted">
                No included options found.
            </div>
        }
        else
        {
            @foreach (var option in Model.IncludedOptions)
            {
                <div class="d-flex justify-content-between align-items-center mb-3 p-2 border rounded bg-light">
                    <div>
                        <span class="fw-semibold">@option.OptionName</span>

                        <span class="badge bg-success ms-2">
                            Included
                        </span>

                        <div class="small text-muted">
                            @option.Category
                        </div>
                    </div>

                    <div class="fw-semibold">
                        @option.BasePrice @option.Currency
                    </div>
                </div>
            }
        }

    </div>
</div>


<!-- ================= OPTIONAL ADD-ONS ================= -->
<div class="card mb-4 shadow-sm">
    <div class="card-header fw-bold bg-light">
        Optional Add-Ons
    </div>

    <div class="card-body" id="optionalAddOnsContainer">

        @if (!Model.OptionalAddOns.Any())
        {
            <div class="text-muted">
                No optional add-ons added yet.
            </div>
        }
        else
        {
            @foreach (var addOn in Model.OptionalAddOns)
            {
                <div class="d-flex justify-content-between align-items-center mb-3 p-2 border rounded">
                    <div>
                        <span class="fw-semibold">
                            @addOn.OptionName
                        </span>

                        <div class="small text-muted">
                            @addOn.Category
                        </div>
                    </div>

                    <div class="d-flex align-items-center gap-3">
                        <span class="fw-semibold">
                            @addOn.BasePrice @addOn.Currency
                        </span>

                        <button type="button"
                                class="btn btn-sm btn-outline-danger"
                                onclick="removeOptionalAddOn(@addOn.OptionId)">
                            Remove
                        </button>
                    </div>
                </div>
            }
        }

    </div>
</div>


<!-- ================= ADD OPTIONAL ADD-ON BUTTON ================= -->
<div class="mb-4">
    <button type="button"
            class="btn btn-primary"
            onclick="loadAvailableAddOns()">
        + Add Optional Add-On
    </button>
</div>


<!-- ================= AVAILABLE ADD-ONS MODAL ================= -->
<div class="modal fade"
     id="availableAddOnsModal"
     tabindex="-1"
     aria-labelledby="availableAddOnsModalLabel"
     aria-hidden="true">

    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content">

            <div class="modal-header">
                <h5 class="modal-title" id="availableAddOnsModalLabel">
                    Select Optional Add-On
                </h5>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal"
                        aria-label="Close">
                </button>
            </div>

            <div class="modal-body">
                <div id="availableAddOnsContainer">
                    <div class="text-muted">
                        Loading available add-ons...
                    </div>
                </div>
            </div>

        </div>
    </div>
</div>


<!-- ================= BACK BUTTON ================= -->
<a asp-area="Admin"
   asp-controller="Tours"
   asp-action="Index"
   class="btn btn-secondary mt-3">
    ← Back to Tours
</a>


@section Scripts
{
    <script>

        const tourId = @Model.TourId;


        // ================= ANTI-FORGERY TOKEN =================

        function getAntiForgeryToken() {

            return document
                .querySelector('input[name="__RequestVerificationToken"]')
                .value;
        }


        // ================= LOAD AVAILABLE ADD-ONS =================

        function loadAvailableAddOns() {

            fetch(`/Admin/TourAddOns/GetAvailableAddOns?tourId=${tourId}`)
                .then(response => {

                    if (!response.ok) {
                        throw new Error(
                            `Failed to load available add-ons. Status: ${response.status}`
                        );
                    }

                    return response.json();
                })
                .then(addOns => {

                    let html = "";

                    if (addOns.length === 0) {

                        html = `
                            <div class="text-muted">
                                No more available add-ons.
                            </div>
                        `;
                    }
                    else {

                        addOns.forEach(addOn => {

                            html += `
                                <div class="d-flex justify-content-between align-items-center mb-3 p-2 border rounded">

                                    <div>
                                        <span class="fw-semibold">
                                            ${addOn.optionName}
                                        </span>

                                        <div class="small text-muted">
                                            ${addOn.category}
                                        </div>
                                    </div>

                                    <div class="d-flex align-items-center gap-3">

                                        <span class="fw-semibold">
                                            ${addOn.basePrice} ${addOn.currency}
                                        </span>

                                        <button type="button"
                                                class="btn btn-sm btn-primary"
                                                onclick="addOptionalAddOn(${addOn.optionId})">
                                            Add
                                        </button>

                                    </div>

                                </div>
                            `;
                        });
                    }

                    document.getElementById(
                        "availableAddOnsContainer"
                    ).innerHTML = html;


                    const modal = new bootstrap.Modal(
                        document.getElementById("availableAddOnsModal")
                    );

                    modal.show();
                })
                .catch(error => {

                    console.error(
                        "Failed to load available add-ons:",
                        error
                    );

                    document.getElementById(
                        "availableAddOnsContainer"
                    ).innerHTML = `
                        <div class="text-danger">
                            Failed to load available add-ons.
                        </div>
                    `;
                });
        }


        // ================= ADD OPTIONAL ADD-ON =================

        function addOptionalAddOn(optionId) {

            fetch(`/Admin/TourAddOns/AddOptionalAddOn`, {
                method: "POST",

                headers: {
                    "Content-Type": "application/json",
                    "RequestVerificationToken": getAntiForgeryToken()
                },

                body: JSON.stringify({
                    tourId: tourId,
                    optionId: optionId
                })
            })
            .then(response => {

                if (!response.ok) {

                    throw new Error(
                        `Failed to add Add-On. Status: ${response.status}`
                    );
                }

                return response;
            })
            .then(() => {

                location.reload();
            })
            .catch(error => {

                console.error(
                    "Failed to add Add-On:",
                    error
                );
            });
        }


        // ================= REMOVE OPTIONAL ADD-ON =================

        function removeOptionalAddOn(optionId) {

            fetch(`/Admin/TourAddOns/RemoveOptionalAddOn`, {
                method: "POST",

                headers: {
                    "Content-Type": "application/json",
                    "RequestVerificationToken": getAntiForgeryToken()
                },

                body: JSON.stringify({
                    tourId: tourId,
                    optionId: optionId
                })
            })
            .then(response => {

                if (!response.ok) {

                    throw new Error(
                        `Failed to remove Add-On. Status: ${response.status}`
                    );
                }

                return response;
            })
            .then(() => {

                location.reload();
            })
            .catch(error => {

                console.error(
                    "Failed to remove Add-On:",
                    error
                );
            });
        }

    </script>
}