@model Tour_Module.Models.Entities.Location

@{
    ViewData["Title"] = "Edit Location";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-md-6">

            <div class="card shadow-sm">
                <div class="card-body">

                    <h5 class="mb-3">Edit Location</h5>

                    <form asp-action="Edit" method="post">

                        <input type="hidden" asp-for="LocationId" />

                        <div class="mb-3">
                            <label class="form-label">Location Name</label>
                            <input asp-for="LocationName" class="form-control" />
                            <span asp-validation-for="LocationName" class="text-danger"></span>
                        </div>

                        <div class="form-check mb-3">
                            <input asp-for="IsActive" class="form-check-input" />
                            <label class="form-check-label">
                                Active
                            </label>
                        </div>

                        @Html.ValidationSummary(false, "", new { @class = "text-danger mb-2" })

                        <div class="d-flex justify-content-end">
                            <a asp-action="Index" class="btn btn-secondary me-2">Cancel</a>
                            <button type="submit" class="btn btn-primary">
                                Save
                            </button>
                        </div>

                    </form>

                </div>
            </div>

        </div>
    </div>
</div>
