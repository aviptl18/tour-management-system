@{
    ViewData["Title"] = "Add Location";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-md-6">

            <div class="card shadow-sm">
                <div class="card-body">

                    <h5 class="mb-3">Add Location</h5>

                    <form asp-action="Create" method="post">

                        <div class="mb-3">
                            <label class="form-label">Location Name</label>
                            <input name="locationName"
                                   class="form-control"
                                   placeholder="e.g. Goa, Paris, Bali" />
                            @Html.ValidationSummary(false, "", new { @class = "text-danger mt-2" })
                        </div>

                        <div class="d-flex justify-content-end">
                            <a asp-action="Index" class="btn btn-secondary me-2">Cancel</a>
                            <button type="submit" class="btn btn-primary">
                                Save
                            </button>
                        </div>

                    </form>

                </div>
            </div>

        </div>
    </div>
</div>
