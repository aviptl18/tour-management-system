@model List<Tour_Module.ViewModels.AddOns.AddOnListViewModel>

@{
    ViewData["Title"] = "Add-Ons";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Add-Ons</h2>
    <a asp-action="Create" class="btn btn-primary">
        Add Add-On
    </a>
</div>

<!-- ================= LIVE SEARCH ================= -->
<div class="row mb-3">
    <div class="col-md-4">
        <input type="text"
               id="addOnSearch"
               class="form-control"
               placeholder="Type to search add-ons..." />
    </div>
</div>

<table class="table table-bordered table-hover align-middle">
    <thead class="table-light">
        <tr>
            <th>Name</th>
            <th>Category</th>
            <th>Price</th>
            <th>Status</th>
            <th style="width:180px;">Actions</th>
        </tr>
    </thead>
    <tbody id="addOnTable">
        @foreach (var item in Model)
        {
            <tr data-name="@item.OptionName.ToLower()"
                data-category="@item.Category.ToLower()">
                <td>@item.OptionName</td>
                <td>@item.Category</td>
                <td>@item.BasePrice @item.Currency</td>
                <td>
                    @if (item.IsActive)
                    {
                        <span class="badge bg-success">Active</span>
                    }
                    else
                    {
                        <span class="badge bg-secondary">Inactive</span>
                    }
                </td>
                <td>
                    <a asp-action="Edit"
                       asp-route-id="@item.OptionId"
                       class="btn btn-sm btn-outline-primary">
                        Edit
                    </a>

                    @if (item.IsActive)
                    {
                        <form asp-action="Deactivate"
                              asp-route-id="@item.OptionId"
                              method="post"
                              class="d-inline">
                            @Html.AntiForgeryToken()
                            <button type="submit"
                                    class="btn btn-sm btn-outline-danger"
                                    onclick="return confirm('Deactivate this add-on?');">
                                Deactivate
                            </button>
                        </form>
                    }
                    else
                    {
                        <form asp-action="Activate"
                              asp-route-id="@item.OptionId"
                              method="post"
                              class="d-inline">
                            @Html.AntiForgeryToken()
                            <button type="submit"
                                    class="btn btn-sm btn-outline-success"
                                    onclick="return confirm('Activate this add-on?');">
                                Activate
                            </button>
                        </form>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>

<!-- ================= LIVE SEARCH SCRIPT ================= -->
<script>
    const addOnSearch = document.getElementById("addOnSearch");
    const rows = document.querySelectorAll("#addOnTable tr");

    addOnSearch.addEventListener("keyup", function () {
        const searchText = this.value.toLowerCase();

        rows.forEach(row => {
            const name = row.dataset.name;
            const category = row.dataset.category;

            const matches =
                name.includes(searchText) ||
                category.includes(searchText);

            row.style.display = matches ? "" : "none";
        });
    });
</script>
