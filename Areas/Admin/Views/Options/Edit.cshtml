@model Tour_Module.ViewModels.Options.OptionEditViewModel

@{
    ViewData["Title"] = "Edit Option";
}

<div class="container">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>Edit Option</h2>

        <a asp-area="Admin"
           asp-controller="Options"
           asp-action="Index"
           class="btn btn-secondary">
            Back to Options
        </a>
    </div>

    <div class="card">
        <div class="card-body">

            <form asp-area="Admin"
                  asp-controller="Options"
                  asp-action="Edit"
                  method="post">

                @Html.AntiForgeryToken()

                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-3">
                </div>

                <input asp-for="OptionId"
                       type="hidden" />

                <div class="mb-3">
                    <label asp-for="OptionName"
                           class="form-label">
                        Option Name
                    </label>

                    <input asp-for="OptionName"
                           class="form-control" />

                    <span asp-validation-for="OptionName"
                          class="text-danger">
                    </span>
                </div>

                <div class="mb-3">
                    <label asp-for="BasePrice"
                           class="form-label">
                        Base Price
                    </label>

                    <input asp-for="BasePrice"
                           type="number"
                           step="0.01"
                           class="form-control" />

                    <span asp-validation-for="BasePrice"
                          class="text-danger">
                    </span>
                </div>

                <div class="mb-3">
                    <label asp-for="Currency"
                           class="form-label">
                        Currency
                    </label>

                    <input asp-for="Currency"
                           class="form-control" />

                    <span asp-validation-for="Currency"
                          class="text-danger">
                    </span>
                </div>

                <div class="mb-3">
                    <label asp-for="Category"
                           class="form-label">
                        Category
                    </label>

                    <input asp-for="Category"
                           class="form-control" />

                    <span asp-validation-for="Category"
                          class="text-danger">
                    </span>
                </div>

                <div class="form-check mb-3">

                    <input asp-for="IsActive"
                           class="form-check-input" />

                    <label asp-for="IsActive"
                           class="form-check-label">
                        Active
                    </label>

                </div>

                <div class="d-flex gap-2">

                    <button type="submit"
                            class="btn btn-primary">
                        Save Changes
                    </button>

                    <a asp-area="Admin"
                       asp-controller="Options"
                       asp-action="Index"
                       class="btn btn-secondary">
                        Cancel
                    </a>

                </div>

            </form>

        </div>
    </div>

</div>

@section Scripts
{
    <partial name="_ValidationScriptsPartial" />
}