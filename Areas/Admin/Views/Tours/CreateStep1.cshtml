@model Tour_Module.ViewModels.Admin.Tours.CreateStep1ViewModel

@{
    ViewData["Title"] = "Add New Tour";
    ViewData["Subtitle"] = "Step 1 of 3 — Basic Tour Information";
}

@section Styles {
    <link rel="stylesheet" href="~/css/admin/forms.css" />
}

<div class="admin-wrapper">

    <!-- HEADER -->
    <div class="admin-page-header">
        <h2 class="admin-title">@ViewData["Title"]</h2>
        <p class="admin-subtitle">@ViewData["Subtitle"]</p>
    </div>

    <!-- STEPPER -->
    <div class="tour-stepper">
        <div class="step active">
            <div class="step-circle">1</div>
            <div class="step-label">Basic Info</div>
        </div>

        <div class="step-line"></div>

        <div class="step">
            <div class="step-circle">2</div>
            <div class="step-label">Media</div>
        </div>

        <div class="step-line"></div>

        <div class="step">
            <div class="step-circle">3</div>
            <div class="step-label">Pricing</div>
        </div>
    </div>

    <!-- STEP 1 FORM -->
    <form asp-action="CreateStep1" method="post">
        @Html.AntiForgeryToken()

        <input type="hidden" asp-for="DraftId" />

        <div class="mb-4">
            <label class="form-label">
                Tour Title <span class="text-danger">*</span>
            </label>

            <input asp-for="TourTitle"
                   class="form-control shadow-sm"
                   placeholder="Enter tour name" />

            <span asp-validation-for="TourTitle"
                  class="text-danger"></span>
        </div>

        <div class="mb-4">
            <label class="form-label">
                Description <span class="text-danger">*</span>
            </label>

            <textarea asp-for="Overview"
                      class="form-control shadow-sm"
                      rows="4"
                      placeholder="Enter short overview about the tour"></textarea>

            <span asp-validation-for="Overview"
                  class="text-danger"></span>
        </div>

        <div class="d-flex justify-content-between mt-4">

            <button type="button"
                    class="btn btn-secondary"
                    onclick="cancelDraft(@Model.DraftId)">
                Cancel
            </button>

            <button type="submit"
                    class="btn btn-primary">
                Next Step →
            </button>

        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

<script>
    function cancelDraft(id) {
        if (!confirm("Cancel this draft?")) return;

        fetch('/Admin/Tours/CancelDraft', {
            method: 'POST',
            headers: {
                'RequestVerificationToken':
                    document.querySelector(
                        'input[name="__RequestVerificationToken"]'
                    ).value,
                'Content-Type': 'application/x-www-form-urlencoded'
            },
            body: `draftId=${id}`
        })
        .then(() => window.location.href = '/Admin/Tours');
    }
</script>