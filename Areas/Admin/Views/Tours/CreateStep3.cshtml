@using Tour_Module.DTOs.Tours.View
@model CreateTourStep3ViewDto

@{
    ViewData["Title"] = "Add New Tour";
    ViewData["Subtitle"] = "Step 3 of 3 — Pricing & Duration";

    var baseItem = Model.Components.FirstOrDefault(x => x.IsBaseComponent);
    var basePriceValue = baseItem?.Price > 0 ? baseItem.Price.ToString() : "";

    bool isEditMode = Model.OriginalTourId != null;
}

@section Styles {
    <link rel="stylesheet" href="~/css/admin/forms.css" />
}

<div class="admin-wrapper">

    <div class="admin-page-header">
        <h2 class="admin-title">@ViewData["Title"]</h2>
        <p class="admin-subtitle">@ViewData["Subtitle"]</p>
    </div>

    <!-- STEP INDICATOR -->
    <div class="tour-stepper">
        <div class="step">
            <div class="step-circle">1</div>
            <div class="step-label">Basic Info</div>
        </div>
        <div class="step-line"></div>
        <div class="step">
            <div class="step-circle">2</div>
            <div class="step-label">Media</div>
        </div>
        <div class="step-line"></div>
        <div class="step active">
            <div class="step-circle">3</div>
            <div class="step-label">Pricing</div>
        </div>
    </div>

    <!-- FORM -->
    <form method="post" asp-action="CompleteStep3">
        @Html.AntiForgeryToken()

        <input type="hidden" asp-for="DraftId" id="DraftId" />
        @if (Model.OriginalTourId != null)
        {
            <input type="hidden" asp-for="OriginalTourId" />
        }

        <!-- Duration -->
        <div class="mb-4">
            <label class="form-label">
                Duration <span class="text-danger">*</span>
            </label>

            <input asp-for="Duration"
                   class="form-control shadow-sm"
                   placeholder="Enter duration" />

            <span asp-validation-for="Duration" class="text-danger"></span>
        </div>

        <!-- Base Price -->
        <div class="mb-4">

            <div class="d-flex justify-content-between align-items-center mb-2">
                <label class="form-label m-0">
                    Base Price (₹) <span class="text-danger">*</span>
                </label>

                <button type="button"
                        id="btnAddOptionRow"
                        class="btn btn-sm btn-outline-primary">
                    +
                </button>
            </div>

            <input type="number"
                   min="1"
                   step="0.01"
                   onwheel="this.blur()"
                   class="form-control shadow-sm base-price"
                   value="@basePriceValue"
                   data-id="@(baseItem?.PricingComponentId)"
                   placeholder="Enter base price" />

            <span id="basePriceError" class="text-danger"></span>

            <div class="form-text">
                Base price is the minimum tour cost.
            </div>
        </div>

        <!-- INCLUDED OPTIONS -->
        <div id="pricingContainer">
            @await Html.PartialAsync("_PricingComponentsPartial", Model.Components)
        </div>

        <!-- BUTTONS -->
        <div class="d-flex justify-content-between mt-4">

            <a asp-action="CreateStep2"
               asp-route-draftId="@Model.DraftId"
               class="btn btn-secondary">
                ← Back
            </a>

            <div class="d-flex gap-2">

                <button type="submit" class="btn btn-primary">
                    Save
                </button>

                <button type="button"
                        id="saveDraftBtn"
                        class="btn btn-warning">
                    Save Draft
                </button>

                @if (!isEditMode)
                {
                    <button type="submit"
                            formaction="@Url.Action("PublishTour", "Tours", new { area = "Admin" })"
                            class="btn btn-success"
                            id="publishBtn"
                            disabled>
                        Add Tour
                    </button>
                }
                else
                {
                    <button type="submit"
                            formaction="@Url.Action("UpdateTour", "Tours", new { area = "Admin" })"
                            class="btn btn-success"
                            id="updateBtn"
                            disabled>
                        Update Tour
                    </button>
                }

            </div>
        </div>
    </form>
</div>

@section Scripts {

    <partial name="_ValidationScriptsPartial" />

    <script src="~/js/admin/create-step3.js"></script>

    <script>

        window.draftStatus = "@Model.Status";
        window.isEditMode = @isEditMode.ToString().ToLower();

        if (draftStatus === "Complete" || draftStatus === "Updated") {

            if (isEditMode) {
                const updateBtn = document.getElementById("updateBtn");
                if (updateBtn) updateBtn.disabled = false;
            }
            else {
                const publishBtn = document.getElementById("publishBtn");
                if (publishBtn) publishBtn.disabled = false;
            }
        }

    </script>

}