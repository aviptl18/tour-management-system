@model IEnumerable<Tour_Module.DTOs.Tours.TourDto>

@{
    ViewData["Title"] = "Tours";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

@section Styles {
    <style>
        /* ==============================
                   PAGE WRAPPER
                ============================== */
        .admin-page {
            width: 95%;
            margin: 0 auto;
        }

        /* ==============================
                   HEADER
                ============================== */
        .admin-page-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 24px;
        }

        /* ==============================
                   GRID (2 CARDS PER ROW)
                ============================== */
        .admin-tour-list {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 24px;
        }

        /* ==============================
                   CARD
                ============================== */
        .admin-tour-card {
            background: #ffffff;
            border-radius: 16px;
            box-shadow: 0 6px 22px rgba(0,0,0,0.08);
            overflow: hidden;
            display: flex;
            flex-direction: column;
        }

        /* ==============================
                   IMAGE (TOP)
                ============================== */
        .tour-image {
            width: 100%;
            height: 220px;
            background: #f1f1f1;
        }

            .tour-image img {
                width: 100%;
                height: 100%;
                object-fit: cover;
            }

        /* ==============================
                   CONTENT (BELOW IMAGE)
                ============================== */
        .tour-content {
            padding: 18px 22px;
            display: flex;
            flex-direction: column;
            gap: 8px;
        }

            .tour-content h5 {
                font-size: 1.3rem;
                font-weight: 700;
                margin: 0;
            }

        .tour-meta {
            font-size: 14px;
            color: #6c757d;
        }

        .tour-price {
            font-size: 15px;
            margin-top: 6px;
        }

            .tour-price span {
                font-weight: 700;
                color: #198754;
            }

        /* ==============================
                   ACTIONS
                ============================== */
        .tour-actions {
            display: flex;
            gap: 10px;
            flex-wrap: wrap;
            margin-top: 14px;
        }

        /* ==============================
                   RESPONSIVE
                ============================== */
        @@media (max-width: 1200px) {
            .admin-tour-list {
                grid-template-columns: 1fr;
            }
        }
    </style>
}

<div class="admin-page">

    <!-- HEADER -->
    <div class="admin-page-header">
        <h2>Tours</h2>

        <a asp-area="Admin"
           asp-controller="Tours"
           asp-action="Create"
           class="btn btn-primary">
            + Create Tour
        </a>
    </div>

    <!-- TOUR LIST -->
    <div class="admin-tour-list">
        @foreach (var tour in Model)
        {
            <div class="admin-tour-card">

                <!-- IMAGE -->
                <div class="tour-image">
                    <img src="@(tour.CoverImageUrl ?? "/images/placeholder.jpg")"
                         alt="@tour.TourTitle" />
                </div>

                <!-- CONTENT -->
                <div class="tour-content">

                    <h5>@tour.TourTitle</h5>

                    <div class="tour-meta">
                        @tour.LocationName • @tour.Duration
                    </div>

                    <div class="tour-price">
                        Starting from
                        <span>₹@(tour.TotalPrice?.ToString("0.00") ?? "0.00")</span>
                    </div>

                    <div class="tour-actions">

                        <a asp-action="Edit"
                           asp-route-tourId="@tour.TourId"
                           class="btn btn-outline-primary btn-sm">
                            Edit
                        </a>

                        <a asp-area="Admin"
                           asp-controller="TourAddOns"
                           asp-action="Configure"
                           asp-route-tourId="@tour.TourId"
                           class="btn btn-outline-success btn-sm">
                            Add-Ons
                        </a>

                        <a asp-area="Admin"
                           asp-controller="Tours"
                           asp-action="Details"
                           asp-route-id="@tour.TourId"
                           class="btn btn-outline-secondary btn-sm">
                            View
                        </a>

                        <a asp-action="Delete"
                           asp-route-id="@tour.TourId"
                           class="btn btn-outline-danger btn-sm">
                            Delete
                        </a>
                    </div>

                </div>
            </div>
        }
    </div>

</div>
