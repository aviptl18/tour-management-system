@model Tour_Module.ViewModels.Admin.Tours.TourDetailsViewModel

@{
    ViewData["Title"] = "Tour Details";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";

    var previewImages = Model.ImageUrls?.Take(3).ToList() ?? new List<string>();
    var remainingCount = Model.ImageUrls != null
        ? Model.ImageUrls.Count - previewImages.Count
        : 0;
}

<style>
    /* ===== Improved Viewer UI (No logic change) ===== */

    .modal-content.bg-dark {
        background: #0f172a !important;
        border-radius: 20px;
        padding: 30px;
    }

    .carousel-item {
        height: 75vh;
    }

        .carousel-item > div {
            height: 100%;
            display: flex;
            justify-content: center;
            align-items: center;
        }

        .carousel-item img {
            max-height: 100%;
            max-width: 100%;
            object-fit: contain;
            border-radius: 18px;
            box-shadow: 0 20px 60px rgba(0,0,0,0.5);
            background: #111;
        }

    .carousel-control-prev,
    .carousel-control-next {
        width: 6%;
    }

    .carousel-control-prev-icon,
    .carousel-control-next-icon {
        background-color: rgba(0,0,0,0.5);
        border-radius: 50%;
        padding: 18px;
    }

    /* Thumbnails polish */
    .thumbnail-img {
        height: 70px;
        width: 95px;
        object-fit: cover;
        cursor: pointer;
        border-radius: 10px;
        transition: 0.3s ease;
        opacity: 0.85;
    }

        .thumbnail-img:hover {
            transform: scale(1.05);
            opacity: 1;
        }

        .thumbnail-img.active-thumb {
            outline: 1px solid #ffffff;
            outline-offset: 3px;
            box-shadow: 0 0 12px rgba(255,255,255,0.6);
        }

</style>

<div class="container-fluid">

    <!-- IMAGE SECTION -->
    <div class="row mb-4">

        <div class="col-md-8">
            <img src="@Model.CoverImageUrl"
                 class="img-fluid rounded"
                 style="height:420px;width:100%;object-fit:cover;cursor:pointer;"
                 data-bs-toggle="modal"
                 data-bs-target="#galleryModal"
                 onclick="openViewer(0)" />
        </div>

        <div class="col-md-4">
            <div class="row g-2">
                @for (int i = 0; i < previewImages.Count; i++)
                {
                    <div class="col-12 position-relative">
                        <img src="@previewImages[i]"
                             class="img-fluid rounded"
                             style="height:136px;width:100%;object-fit:cover;cursor:pointer;"
                             data-bs-toggle="modal"
                             data-bs-target="#galleryModal"
                             onclick="openViewer(@i)" />

                        @if (i == previewImages.Count - 1 && remainingCount > 0)
                        {
                            <div class="position-absolute top-0 start-0 w-100 h-100
                                                d-flex align-items-center justify-content-center
                                                text-white fw-bold"
                                 style="background:rgba(0,0,0,0.6);border-radius:8px;cursor:pointer;"
                                 data-bs-toggle="modal"
                                 data-bs-target="#galleryModal"
                                 onclick="openViewer(@i)">
                                +@remainingCount more
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
    </div>

    <h2 class="fw-bold">@Model.TourTitle</h2>

    <div class="mb-4">
        <p class="text-muted">@Model.Overview</p>
    </div>

    <table class="table table-bordered w-100 mb-4">
        <thead class="table-light">
            <tr>
                <th>Location</th>
                <th>Duration</th>
                <th>Base Price</th>
                <th>Included Options</th>
                <th>Total Price</th>
            </tr>
        </thead>
        <tbody>
            <tr>
                <td>@Model.LocationName</td>
                <td>@Model.Duration</td>
                <td>₹ @Model.BasePrice</td>
                <td>₹ @Model.IncludedTotal</td>
                <td><strong>₹ @Model.TotalPrice</strong></td>
            </tr>
        </tbody>
    </table>

    <h5 class="fw-semibold">Included Options</h5>

    @if (Model.AddOns?.Any() == true)
    {
        <ul class="mb-4">
            @foreach (var addOn in Model.AddOns)
            {
                <li>@addOn</li>
            }
        </ul>
    }
    else
    {
        <p class="text-muted mb-4">No add-ons assigned.</p>
    }

    <div class="d-flex gap-2 mb-5">
        <a asp-action="Index" class="btn btn-secondary">Back</a>
        @* <a asp-action="Edit" asp-route-id="@Model.TourId" class="btn btn-primary">Edit</a> *@
    </div>

</div>

<!-- GALLERY MODAL -->
<div class="modal fade" id="galleryModal" tabindex="-1">
    <div class="modal-dialog modal-xl modal-dialog-centered">
        <div class="modal-content bg-dark border-0">

            <div class="modal-body text-center position-relative">

                <button type="button"
                        class="btn-close btn-close-white position-absolute top-0 end-0 m-3"
                        style="z-index:1060"
                        onclick="closeGallery(event)">
                </button>

                <div id="carouselViewer"
                     class="carousel slide"
                     data-bs-interval="false"
                     data-bs-touch="true">

                    <div class="carousel-inner">

                        @for (int i = 0; i < Model.ImageUrls.Count; i++)
                        {
                            <div class="carousel-item @(i == 0 ? "active" : "")">
                                <div>
                                    <img src="@Model.ImageUrls[i]" />
                                </div>
                            </div>
                        }

                    </div>

                    <button class="carousel-control-prev"
                            type="button"
                            data-bs-target="#carouselViewer"
                            data-bs-slide="prev">
                        <span class="carousel-control-prev-icon"></span>
                    </button>

                    <button class="carousel-control-next"
                            type="button"
                            data-bs-target="#carouselViewer"
                            data-bs-slide="next">
                        <span class="carousel-control-next-icon"></span>
                    </button>
                </div>

                <div class="d-flex justify-content-center gap-2 mt-4 flex-wrap">
                    @for (int i = 0; i < Model.ImageUrls.Count; i++)
                    {               
                        <img src="@Model.ImageUrls[i]"
                              class="thumbnail-img"
                              data-index="@i"
                              onclick="jumpTo(@i)">
                    }
                </div>

            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
                let carousel;

        function openViewer(index) {
            setTimeout(() => {
                carousel = bootstrap.Carousel.getOrCreateInstance(
                    document.getElementById('carouselViewer')
                );
                carousel.to(index);
                setActiveThumbnail(index);
            }, 150);
        }

        function jumpTo(index) {
            if (carousel) {
                carousel.to(index);
                setActiveThumbnail(index);
            }
        }

        function setActiveThumbnail(index) {
            const thumbs = document.querySelectorAll('.thumbnail-img');
            thumbs.forEach(t => t.classList.remove('active-thumb'));

            const active = document.querySelector(`.thumbnail-img[data-index='${index}']`);
            if (active) active.classList.add('active-thumb');
        }

        document.getElementById('carouselViewer')
            .addEventListener('slid.bs.carousel', function (e) {
                setActiveThumbnail(e.to);
            });

        function closeGallery(e) {
            e.stopPropagation();
            const modal = bootstrap.Modal.getInstance(
                document.getElementById('galleryModal')
            );
            modal.hide();
        }
    </script>
}