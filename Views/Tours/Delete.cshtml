@model Tour_Module.DTOs.Tours.TourDto

<h2 class="mt-3 mb-4">Delete Tour</h2>

<div class="alert alert-danger">
    Are you sure you want to delete this tour?
</div>

<table class="table">
    <tr>
        <th>Tour Title</th>
        <td>@Model.TourTitle</td>
    </tr>
    <tr>
        <th>Location</th>
        <td>@Model.LocationName</td>
    </tr>

    <tr>
        <th>Price</th>
        <td>@Model.TotalPrice</td>
    </tr>
    <tr>
        <th>Duration</th>
        <td>@Model.Duration</td>
    </tr>
</table>

<div class="d-flex align-items-center gap-2">

    <!-- DELETE FORM -->
    <form method="post" asp-action="DeleteConfirmed" class="m-0">
        <input type="hidden" name="id" value="@Model.TourId" />
        <button type="submit" class="btn btn-danger">Delete</button>
    </form>

    <!-- CANCEL BUTTON OUTSIDE THE FORM (SAFE) -->
    <a asp-action="Index" class="btn btn-secondary">Cancel</a>

</div>


