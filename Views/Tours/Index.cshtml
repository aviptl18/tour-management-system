@model IEnumerable<Tour_Module.DTOs.Tours.TourDto>

@{
    ViewData["Title"] = "Tours";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-5 pb-5">

    <h2 class="fw-bold mb-4">Explore Tours</h2>

    @if (!Model.Any())
    {
        <div class="alert alert-warning text-center">
            No tours available.
        </div>
    }
    else
    {
        <div class="row">
            @foreach (var tour in Model)
            {
                <div class="col-md-4 mb-4">
                    <div class="card shadow-sm border-0 h-100">

                        <!-- IMAGE -->
                        <a asp-controller="Tours"
                           asp-action="Details"
                           asp-route-id="@tour.TourId">

                            <img src="@(string.IsNullOrEmpty(tour.CoverImageUrl)
                                                                          ? "/images/placeholder.jpg"
                                                                          : tour.CoverImageUrl)"
                         class="card-img-top"
                         style="height:200px; object-fit:cover;"
                         alt="@tour.TourTitle" />
                </a>

                        <div class="card-body d-flex flex-column">

                            <!-- TITLE -->
                            <h5 class="card-title fw-bold mb-1">
                                <a asp-controller="Tours"
                                   asp-action="Details"
                                   asp-route-id="@tour.TourId"
                                   class="text-decoration-none text-dark">
                                    @tour.TourTitle
                                </a>
                            </h5>

                            <!-- META -->
                            <p class="text-muted mb-1">
                                @tour.LocationName • @tour.Duration
                            </p>

                            <!-- OVERVIEW -->
                            @* <p class="small text-muted flex-grow-1"
                               style="overflow:hidden; text-overflow:ellipsis;">
                                @tour.Overview
                            </p> *@

                            <!-- PRICE -->
                            <p class="fw-semibold text-success mb-2">
                                Starting from <strong>₹@((tour.TotalPrice ?? 0).ToString("N2"))</strong>
                            </p>


                            <!-- CTA -->
                            <a asp-controller="Tours"
                               asp-action="Details"
                               asp-route-id="@tour.TourId"
                               class="btn btn-outline-primary btn-sm">
                                View
                            </a>

                        </div>
                    </div>
                </div>
                }
        </div>
    }
</div>
