@model Tour_Module.DTOs.Tours.UserTourDetailsDto

@{
    ViewData["Title"] = Model.TourTitle;
    Layout = "~/Views/Shared/_Layout.cshtml";

    var previewImages = Model.ImageUrls?.Take(3).ToList() ?? new List<string>();
    var remainingCount = Model.ImageUrls != null
        ? Model.ImageUrls.Count - previewImages.Count
        : 0;
}

<style>
    /* Dark backdrop */
    .modal-backdrop.show {
        background-color: #000 !important;
        opacity: 0.5;
    }

    /* Modal background */
    .modal-content {
        background: #000 !important;
        border-radius: 20px;
    }

    /* Thumbnail hover */
    .thumbnail-img:hover {
        transform: scale(1.05);
        opacity: 1;
    }
</style>

<div class="container mt-4 pb-5">

    <!-- IMAGE SECTION -->
    <div class="row mb-4">

        <div class="col-md-8">
            <img src="@Model.CoverImageUrl"
                 class="img-fluid rounded shadow-sm"
                 style="height:420px;width:100%;object-fit:cover;cursor:pointer;"
                 data-bs-toggle="modal"
                 data-bs-target="#galleryModal"
                 onclick="openViewer(0)" />
        </div>

        <div class="col-md-4">
            <div class="row g-2">
                @for (int i = 0; i < previewImages.Count; i++)
                {
                    <div class="col-12 position-relative">
                        <img src="@previewImages[i]"
                             class="img-fluid rounded shadow-sm"
                             style="height:136px;width:100%;object-fit:cover;cursor:pointer;"
                             data-bs-toggle="modal"
                             data-bs-target="#galleryModal"
                             onclick="openViewer(@i)" />

                        @if (i == previewImages.Count - 1 && remainingCount > 0)
                        {
                            <div class="position-absolute top-0 start-0 w-100 h-100
                                                d-flex align-items-center justify-content-center
                                                text-white fw-bold"
                                 style="background:rgba(0,0,0,0.6);
                                                border-radius:8px;
                                                cursor:pointer;"
                                 data-bs-toggle="modal"
                                 data-bs-target="#galleryModal"
                                 onclick="openViewer(@i)">
                                +@remainingCount more
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
    </div>

    <h2 class="fw-bold">@Model.TourTitle</h2>

    <div class="mb-4">
        <p class="text-muted">@Model.Overview</p>
    </div>

    <table class="table table-bordered w-100 mb-4">
        <thead class="table-light">
            <tr>
                <th>Location</th>
                <th>Duration</th>
                <th>Base Price</th>
                <th>Included Options</th>
                <th>Total Price</th>
            </tr>
        </thead>
        <tbody>
            <tr>
                <td>@Model.LocationName</td>
                <td>@Model.Duration</td>
                <td>₹ @Model.BasePrice.ToString("N2")</td>
                <td>₹ @Model.IncludedTotal.ToString("N2")</td>
                <td><strong>₹ @Model.TotalPrice.ToString("N2")</strong></td>
            </tr>
        </tbody>
    </table>

    <h5 class="fw-bold">Included Add-ons</h5>

    @if (Model.AddOns != null && Model.AddOns.Any())
    {
        <ul class="mb-4">
            @foreach (var addOn in Model.AddOns)
            {
                <li>@addOn</li>
            }
        </ul>
    }
    else
    {
        <p class="text-muted mb-4">No add-ons included.</p>
    }

    <a asp-controller="UserTour"
       asp-action="Index"
       class="btn btn-outline-secondary">
        ← Back to Tours
    </a>
</div>

<!-- MODAL VIEWER -->
<div class="modal fade" id="galleryModal" tabindex="-1">
    <div class="modal-dialog modal-xl modal-dialog-centered">
        <div class="modal-content border-0">

            <div class="modal-body text-center position-relative p-4">

                <button type="button"
                        class="btn-close btn-close-white position-absolute top-0 end-0 m-4"
                        style="z-index:1060"
                        onclick="closeGallery(event)">
                </button>

                <div id="carouselViewer"
                     class="carousel slide"
                     data-bs-interval="false"
                     data-bs-touch="true">

                    <div class="carousel-inner">

                        @for (int i = 0; i < Model.ImageUrls.Count; i++)
                        {
                            <div class="carousel-item @(i == 0 ? "active" : "")">
                                <div class="d-flex justify-content-center align-items-center"
                                     style="height:80vh;">
                                    <img src="@Model.ImageUrls[i]"
                                         style="max-height:75vh;
                                                    max-width:85%;
                                                    object-fit:contain;
                                                    border-radius:20px;
                                                    box-shadow:0 20px 60px rgba(0,0,0,0.6);" />
                                </div>
                            </div>
                        }

                    </div>

                    <button class="carousel-control-prev"
                            type="button"
                            data-bs-target="#carouselViewer"
                            data-bs-slide="prev">
                        <span class="carousel-control-prev-icon"></span>
                    </button>

                    <button class="carousel-control-next"
                            type="button"
                            data-bs-target="#carouselViewer"
                            data-bs-slide="next">
                        <span class="carousel-control-next-icon"></span>
                    </button>
                </div>

                <!-- THUMBNAILS -->
                <div class="d-flex justify-content-center gap-3 mt-4 flex-wrap">
                    @for (int i = 0; i < Model.ImageUrls.Count; i++)
                    {
                        <img src="@Model.ImageUrls[i]"
                             id="thumb-@i"
                             onclick="jumpTo(@i)"
                             style="height:75px;
                                        width:110px;
                                        object-fit:cover;
                                        cursor:pointer;
                                        border-radius:12px;
                                        border:3px solid transparent;
                                        transition:0.3s;">
                    }
                </div>

            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        let carousel;

        function openViewer(index) {
            setTimeout(() => {
                carousel = bootstrap.Carousel.getOrCreateInstance(
                    document.getElementById('carouselViewer')
                );
                carousel.to(index);
                setActiveThumb(index);
            }, 150);
        }

        function jumpTo(index) {
            if (carousel) {
                carousel.to(index);
                setActiveThumb(index);
            }
        }

        function setActiveThumb(index) {
            document.querySelectorAll('[id^="thumb-"]').forEach(t => {
                t.style.border = "1px solid transparent";
            });

            const active = document.getElementById('thumb-' + index);
            if (active) {
                active.style.border = "1px solid #ffffff";
            }
        }

        function closeGallery(e) {
            e.stopPropagation();
            const modal = bootstrap.Modal.getInstance(
                document.getElementById('galleryModal')
            );
            modal.hide();
        }

        document.getElementById('carouselViewer')
            .addEventListener('slid.bs.carousel', function (event) {
                setActiveThumb(event.to);
            });
    </script>
}