@{
    ViewData["Title"] = "Search Location";
}

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />

<div class="container mt-5" style="max-width: 600px;">
    <h2 class="text-center mb-4">Search Location</h2>

    <!-- Search Box -->
    <div class="form-group position-relative">
        <input type="text" id="locationSearch"
               class="form-control form-control-lg"
               placeholder="Type location name..."
               autocomplete="off">

        <!-- Dropdown -->
        <ul id="searchResults"
            class="list-group position-absolute w-100 shadow"
            style="z-index: 999; display: none;">
        </ul>
    </div>

    <!-- Selected Result Display -->
    <div class="mt-4 p-3 bg-light border rounded d-none" id="selectedBox">
        <h5>You selected:</h5>
        <p id="selectedLocation" class="fw-bold text-primary"></p>
    </div>
</div>

<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

<script>
    $("#locationSearch").on("keyup", function () {

        let term = $(this).val();

        if (term.length < 1) {
            $("#searchResults").hide();
            return;
        }

        $.ajax({
            url: "/Locations/Search",
            type: "GET",
            data: { term: term },
            success: function (data) {

                if (data.length === 0) {
                    $("#searchResults").html(`<li class="list-group-item">No results found</li>`).show();
                    return;
                }

                let items = "";

                data.forEach(item => {
                    items += `
                        <li class="list-group-item list-group-item-action"
                            onclick="selectLocation('${item.label}', '${item.value}')">
                            ${item.label}
                        </li>`;
                });

                $("#searchResults").html(items).show();
            }
        });
    });

    function selectLocation(name, id) {
        $("#locationSearch").val(name);
        $("#searchResults").hide();

        $("#selectedLocation").text(name + " (ID: " + id + ")");
        $("#selectedBox").removeClass("d-none");
    }

    // Hide dropdown when clicking outside
    $(document).click(function (e) {
        if (!$(e.target).closest('#locationSearch').length) {
            $("#searchResults").hide();
        }
    });
</script>
