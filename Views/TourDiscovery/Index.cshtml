@model Tour_Module.ViewModels.User.TourDiscovery.TourDiscoveryViewModel

@{
    ViewData["Title"] = "Discover Tours";
}

<div class="container py-4">

    <h2 class="mb-4">Discover Tours</h2>

    <!-- FILTERS -->
    <form asp-controller="TourDiscovery"
          asp-action="Index"
          method="get"
          class="row g-3 mb-4">

        <div class="col-md-4">
            <label asp-for="Filter.SearchTerm"
                   class="form-label">
                Search
            </label>

            <input asp-for="Filter.SearchTerm"
                   class="form-control"
                   placeholder="Search tour title..." />
        </div>

        <div class="col-md-2">
            <label asp-for="Filter.LocationName"
                   class="form-label">
                Location
            </label>

            <input asp-for="Filter.LocationName"
                   class="form-control"
                   type="text"
                   list="locationList"
                   placeholder="Enter location..." />

            <datalist id="locationList">
                @foreach (var location in Model.LocationNames)
                {
                    <option value="@location"></option>
                }
            </datalist>
        </div>

        <div class="col-md-2">
            <label asp-for="Filter.MinPrice"
                   class="form-label">
                Min Price
            </label>

            <input asp-for="Filter.MinPrice"
                   class="form-control"
                   type="number"
                   step="0.01"
                   min="0" />
        </div>

        <div class="col-md-2">
            <label asp-for="Filter.MaxPrice"
                   class="form-label">
                Max Price
            </label>

            <input asp-for="Filter.MaxPrice"
                   class="form-control"
                   type="number"
                   step="0.01"
                   min="0" />
        </div>

        <div class="col-md-2">
            <label asp-for="Filter.SortBy"
                   class="form-label">
                Sort By
            </label>

            <select asp-for="Filter.SortBy"
                    class="form-select">

                <option value="Newest">
                    Newest
                </option>

                <option value="PriceLowToHigh">
                    Price: Low to High
                </option>

                <option value="PriceHighToLow">
                    Price: High to Low
                </option>

                <option value="NameAscending">
                    Name: A to Z
                </option>

                <option value="NameDescending">
                    Name: Z to A
                </option>

            </select>
        </div>

        <div class="col-12">

            <button type="submit"
                    class="btn btn-primary">
                Search
            </button>

            <a asp-controller="TourDiscovery"
               asp-action="Index"
               class="btn btn-outline-secondary ms-2">
                Clear
            </a>

        </div>

    </form>


    <!-- RESULT COUNT -->

    <div class="mb-3">

        <strong>
            @Model.TotalCount
        </strong>

        tour(s) found.

    </div>


    <!-- TOUR CARDS -->

    @if (Model.Tours.Any())
    {
        <div class="row g-4">

            @foreach (var tour in Model.Tours)
            {
                <div class="col-md-6 col-lg-4">

                    <div class="card h-100 shadow-sm">

                        @if (!string.IsNullOrWhiteSpace(
                            tour.CoverImageUrl))
                        {
                            <img src="@tour.CoverImageUrl"
                                 class="card-img-top"
                                 alt="@tour.TourTitle"
                                 style="height: 220px; object-fit: cover;" />
                        }
                        else
                        {
                            <div class="bg-light d-flex align-items-center justify-content-center"
                                 style="height: 220px;">

                                <span class="text-muted">
                                    No image available
                                </span>

                            </div>
                        }

                        <div class="card-body d-flex flex-column">

                            <h5 class="card-title">
                                @tour.TourTitle
                            </h5>

                            <p class="card-text mb-1">
                                <strong>Location:</strong>
                                @tour.LocationName
                            </p>

                            @if (!string.IsNullOrWhiteSpace(
                                tour.Duration))
                            {
                                <p class="card-text mb-1">
                                    <strong>Duration:</strong>
                                    @tour.Duration
                                </p>
                            }

                            <p class="card-text mt-2">

                                <strong>
                                    Price:
                                </strong>

                                @if (tour.TotalPrice.HasValue)
                                {
                                    <span>
                                        ₹@tour.TotalPrice.Value.ToString("N2")
                                    </span>
                                }
                                else
                                {
                                    <span class="text-muted">
                                        Not available
                                    </span>
                                }

                            </p>

                            <div class="mt-auto">

                                <a asp-controller="TourDiscovery"
                                   asp-action="Details"
                                   asp-route-id="@tour.TourId"
                                   class="btn btn-primary">
                                    View Details
                                </a>

                            </div>

                        </div>

                    </div>

                </div>
            }

        </div>
    }
    else
    {
        <div class="alert alert-info">
            No tours found matching your search criteria.
        </div>
    }


    <!-- PAGINATION -->

    @if (Model.TotalPages > 1)
    {
        <nav class="mt-4"
             aria-label="Tour pagination">

            <ul class="pagination justify-content-center">

                @if (Model.PageNumber > 1)
                {
                    <li class="page-item">

                        <a class="page-link"
                           asp-controller="TourDiscovery"
                           asp-action="Index"
                           asp-route-SearchTerm="@Model.Filter.SearchTerm"
                           asp-route-LocationName="@Model.Filter.LocationName"
                           asp-route-MinPrice="@Model.Filter.MinPrice"
                           asp-route-MaxPrice="@Model.Filter.MaxPrice"
                           asp-route-SortBy="@Model.Filter.SortBy"
                           asp-route-PageNumber="@(Model.PageNumber - 1)"
                           asp-route-PageSize="@Model.PageSize">
                            Previous
                        </a>

                    </li>
                }

                @for (int pageNumber = 1;
                            pageNumber <= Model.TotalPages;
                            pageNumber++)
                {
                    <li class="page-item @(pageNumber == Model.PageNumber ? "active" : "")">

                        <a class="page-link"
                           asp-controller="TourDiscovery"
                           asp-action="Index"
                           asp-route-SearchTerm="@Model.Filter.SearchTerm"
                           asp-route-LocationName="@Model.Filter.LocationName"
                           asp-route-MinPrice="@Model.Filter.MinPrice"
                           asp-route-MaxPrice="@Model.Filter.MaxPrice"
                           asp-route-SortBy="@Model.Filter.SortBy"
                           asp-route-PageNumber="@pageNumber"
                           asp-route-PageSize="@Model.PageSize">
                            @pageNumber
                        </a>

                    </li>
                }

                @if (Model.PageNumber < Model.TotalPages)
                {
                    <li class="page-item">

                        <a class="page-link"
                           asp-controller="TourDiscovery"
                           asp-action="Index"
                           asp-route-SearchTerm="@Model.Filter.SearchTerm"
                           asp-route-LocationName="@Model.Filter.LocationName"
                           asp-route-MinPrice="@Model.Filter.MinPrice"
                           asp-route-MaxPrice="@Model.Filter.MaxPrice"
                           asp-route-SortBy="@Model.Filter.SortBy"
                           asp-route-PageNumber="@(Model.PageNumber + 1)"
                           asp-route-PageSize="@Model.PageSize">
                            Next
                        </a>

                    </li>
                }

            </ul>

        </nav>
    }

</div>